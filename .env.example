# Server-only developer settings. Copy to .env.local and replace placeholders.
# Never commit .env.local or real credentials.
HOST=127.0.0.1
PORT=4173
GUMMY_PUBLIC_ORIGIN=http://127.0.0.1:4173
GUMMY_SESSION_SECRET=replace-with-a-long-random-secret
GUMMY_TEST_MODE=0

# Optional bounded OpenAI transformation route.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
OPENAI_PRICE_TABLE_VERSION=

# Optional engineering GitHub connector and live-smoke fixture.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_INSTALLATION_ID=
GITHUB_TEST_REPOSITORY=
