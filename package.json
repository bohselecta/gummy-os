{
  "name": "gummy-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gummy is a provider-neutral personal AI computer, social protocol, and governed enterprise software habitat delivered through the browser.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "NODE_ENV=production node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/validate.mjs && node scripts/audit-colors.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm test && npm run build && npm run test:e2e",
    "test:live": "node scripts/live-smoke.mjs",
    "evidence": "playwright test tests/e2e/evidence.spec.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "dependencies": {
    "@octokit/app": "^16.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "idb": "^8.0.3",
    "openai": "^6.49.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "fake-indexeddb": "^6.2.5",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.2.0"
  }
}
