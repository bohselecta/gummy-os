{
  "name": "gummy-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gummy is a provider-neutral personal AI computer, social protocol, and governed enterprise software habitat delivered through the browser.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/validate.mjs",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/core.test.mjs tests/production-runtime.test.mjs",
    "test:integration": "node --test tests/*.integration.test.mjs",
    "test:e2e": "playwright test tests/e2e/production.spec.mjs --project=chromium",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.mjs --project=chromium",
    "test:visual": "playwright test tests/e2e/visual.spec.mjs --project=chromium",
    "test:cross-browser": "playwright test tests/e2e/smoke.spec.mjs --project=firefox --project=webkit",
    "test:acceptance": "playwright test tests/e2e/production.spec.mjs tests/e2e/accessibility.spec.mjs tests/e2e/visual.spec.mjs --project=chromium",
    "evidence": "node scripts/generate-evidence.mjs",
    "verify": "npm run check && npm run test:unit && npm run test:integration && npm run build && npm run test:e2e && npm run test:a11y && npm run test:visual && npm run test:cross-browser"
  },
  "engines": { "node": ">=22" },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "4.12.1"
  }
}
