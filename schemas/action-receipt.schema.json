{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mygum.my/schemas/action-receipt.schema.json",
  "title": "Gummy OS Action Receipt",
  "description": "Evidence of a Human-sponsored action performed directly or by an Agent through an Actor, Mold, Task Lease, Grant, and Master Control policy.",
  "type": "object",
  "required": ["schema", "id", "action", "humanAuthorityId", "actorId", "operatorType", "operatorId", "moldId", "application", "outcome", "createdAt"],
  "properties": {
    "schema": { "const": "gummy.action-receipt/v0" },
    "id": { "type": "string", "pattern": "^receipt:" },
    "action": { "type": "string", "minLength": 1 },
    "humanAuthorityId": { "type": "string", "pattern": "^human:" },
    "actorId": { "type": "string", "pattern": "^actor:" },
    "actorAddress": { "type": "string", "pattern": "^@" },
    "operatorType": { "enum": ["human", "agent"] },
    "operatorId": { "type": "string", "pattern": "^(human|agent):" },
    "agentId": { "type": "string", "pattern": "^agent:" },
    "characterFamily": { "type": "string", "description": "Human-facing family such as Glopper; never substitutes for agentId." },
    "moldId": { "type": "string", "pattern": "^mold:" },
    "masterControlId": { "type": "string", "pattern": "^master-control:" },
    "taskLeaseId": { "type": "string", "pattern": "^lease:" },
    "application": { "type": "string" },
    "applicationPackId": { "type": "string", "pattern": "^pack:" },
    "executionRoute": {
      "type": "object",
      "properties": {
        "providerClass": { "type": "string" },
        "model": { "type": "string" },
        "runtime": { "type": "string" },
        "locality": { "enum": ["web", "local", "lan", "cloud", "organization", "phone", "unknown"] },
        "authoritativeLocation": { "type": "string" },
        "syncMode": { "enum": ["none", "manual", "approved", "continuous"] }
      },
      "additionalProperties": true
    },
    "grantIds": { "type": "array", "items": { "type": "string", "pattern": "^grant:" }, "uniqueItems": true },
    "sourceGummyIds": { "type": "array", "items": { "type": "string", "pattern": "^gummy:" }, "uniqueItems": true },
    "resultGummyIds": { "type": "array", "items": { "type": "string", "pattern": "^gummy:" }, "uniqueItems": true },
    "linkIds": { "type": "array", "items": { "type": "string", "pattern": "^link:" }, "uniqueItems": true },
    "grabIds": { "type": "array", "items": { "type": "string", "pattern": "^grab:" }, "uniqueItems": true },
    "resources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "outcome": { "enum": ["completed", "denied", "failed", "cancelled", "rolled-back"] },
    "reversible": { "type": "boolean" },
    "cost": {
      "type": "object",
      "properties": {
        "currency": { "type": "string" },
        "amount": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "sourceHashes": { "type": "array", "items": { "type": "string" } },
        "resultHashes": { "type": "array", "items": { "type": "string" } },
        "traceRef": { "type": "string" },
        "revocationProof": { "type": "string" },
        "burnResetProof": { "type": "string" }
      },
      "additionalProperties": true
    },
    "detail": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "legacyActor": { "type": "string", "description": "Protocol 0.1 compatibility input only." },
    "extensions": { "type": "object" }
  },
  "additionalProperties": true
}
