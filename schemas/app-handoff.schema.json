{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mygum.my/schemas/app-handoff.schema.json",
  "title": "Gummy OS Application Handoff",
  "type": "object",
  "required": [
    "schema",
    "id",
    "sourceApplicationId",
    "targetApplicationId",
    "sourceProtocolVersion",
    "targetProtocolVersion",
    "projectId",
    "artifactType",
    "assetRefs",
    "provenance",
    "rights",
    "hashes",
    "limitations",
    "evidenceRefs",
    "sourceEnvelope",
    "createdAt"
  ],
  "properties": {
    "schema": { "const": "gummy.app-handoff/v1" },
    "id": { "type": "string", "pattern": "^handoff:" },
    "sourceApplicationId": { "type": "string", "pattern": "^app:" },
    "targetApplicationId": { "type": "string", "pattern": "^app:" },
    "sourceProtocolVersion": { "type": "string", "minLength": 1 },
    "targetProtocolVersion": { "type": "string", "minLength": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "artifactType": { "type": "string", "minLength": 1 },
    "assetRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "revision": { "type": ["string", "integer", "null"] }
        },
        "additionalProperties": true
      }
    },
    "provenance": { "type": "object" },
    "rights": { "type": "object" },
    "hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["algorithm", "value"],
        "properties": {
          "algorithm": { "const": "sha256" },
          "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": true
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "sourceEnvelope": { "type": "object" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
