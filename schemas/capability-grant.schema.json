{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mygum.my/schemas/capability-grant.schema.json",
  "title": "Gummy OS Capability Grant",
  "description": "Temporary explicit authority for one Agent or Human operator to act through one Actor under a Mold and Master Control policy.",
  "type": "object",
  "required": ["schema", "id", "humanAuthorityId", "actorId", "operatorType", "operatorId", "moldId", "action", "resource", "risk", "issuedAt", "expiresAt", "revoked"],
  "properties": {
    "schema": { "const": "gummy.capability-grant/v0" },
    "id": { "type": "string", "pattern": "^grant:" },
    "humanAuthorityId": { "type": "string", "pattern": "^human:" },
    "actorId": { "type": "string", "pattern": "^actor:" },
    "operatorType": { "enum": ["human", "agent"] },
    "operatorId": { "type": "string", "pattern": "^(human|agent):" },
    "agentId": { "type": "string", "pattern": "^agent:" },
    "moldId": { "type": "string", "pattern": "^mold:" },
    "masterControlId": { "type": "string", "pattern": "^master-control:" },
    "action": { "type": "string", "minLength": 1 },
    "resource": { "type": "string", "minLength": 1 },
    "resourceKind": { "enum": ["gummy", "bowl", "link", "application", "connector", "runtime", "organization", "conversation", "actor", "other"] },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "reason": { "type": "string" },
    "scope": { "type": "object" },
    "locality": { "enum": ["web", "local", "lan", "cloud", "organization", "unknown"] },
    "approval": { "enum": ["policy", "human", "organization", "combined"] },
    "issuerId": { "type": "string" },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "revoked": { "type": "boolean" },
    "revokedAt": { "type": "string", "format": "date-time" },
    "legacyActor": { "type": "string", "description": "Protocol 0.1 compatibility input only." },
    "extensions": { "type": "object" }
  },
  "additionalProperties": true
}
