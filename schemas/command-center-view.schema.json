{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mygum.my/schemas/command-center-view.schema.json",
  "title": "Gummy Command Center View",
  "description": "Generated cross-system attention projection. It is never an authority source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "ownerActorId", "attentionItems", "activeProductions", "activeSocialInstances", "sharedVisions", "activeAgents", "workOrders", "returns", "receipts", "productionPools", "contributionChanges", "waitingHumanDecisions", "blockers", "expiringPermissions", "presenceChanges", "distributionPlans", "resumeOpportunities", "sourceRevisions", "generatedAt", "authoritySource"],
  "properties": {
    "schema": { "const": "gummy.command-center-view/v1" },
    "id": { "type": "string", "pattern": "^command-center-view:" },
    "ownerActorId": { "type": "string", "pattern": "^actor:" },
    "lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["now", "next", "delegated", "review", "blocked", "done"],
      "properties": {
        "now": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
        "next": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
        "delegated": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
        "review": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
        "blocked": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
        "done": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "label": { "type": "string" },
            "lane": { "type": "string" },
            "disclosure": { "type": "string" }
          }
        }
      }
    },
    "attentionItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "title", "sourceObject", "materialState", "authorityRequired", "nextVerb", "explanation"],
        "properties": {
          "id": { "type": "string", "pattern": "^attention:" },
          "class": { "enum": ["needs-decision", "needs-approval", "needs-input", "needs-connection", "running", "recovering", "ready-for-review", "ready-to-accept", "blocked", "failed", "cost-changed", "permission-expiring", "presence-changed", "ready-to-publish", "completed"] },
          "title": { "type": "string", "minLength": 1 },
          "sourceObject": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "revision"],
            "properties": {
              "kind": { "enum": ["actor-presence", "social-instance", "shared-vision", "production", "production-run", "production-pool", "work-order", "job", "return", "receipt", "distribution-plan", "other"] },
              "id": { "type": "string", "minLength": 1 },
              "revision": { "type": ["integer", "string", "null"] }
            }
          },
          "materialState": { "enum": ["proposal", "committed", "executing", "materialized", "verified", "failed", "no-op"] },
          "authorityRequired": { "type": ["string", "null"] },
          "nextVerb": { "type": "string", "minLength": 1 },
          "route": { "type": ["string", "null"] },
          "cost": {
            "type": ["object", "null"],
            "properties": {
              "currency": { "const": "USD" },
              "estimate": { "type": ["number", "null"], "minimum": 0 },
              "maximum": { "type": ["number", "null"], "minimum": 0 },
              "actual": { "type": ["number", "null"], "minimum": 0 }
            },
            "additionalProperties": false
          },
          "receiptIds": { "type": "array", "items": { "type": "string", "pattern": "^receipt:" }, "uniqueItems": true },
          "explanation": { "type": "string", "minLength": 1 },
          "generatedBy": { "enum": ["system", "zeke", "human"] }
        }
      }
    },
    "activeProductions": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
    "activeSocialInstances": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
    "sharedVisions": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
    "activeAgents": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
    "workOrders": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
    "jobs": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
    "returns": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
    "receipts": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
    "productionPools": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
    "contributionChanges": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
    "waitingHumanDecisions": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
    "blockers": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
    "expiringPermissions": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
    "presenceChanges": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
    "distributionPlans": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
    "resumeOpportunities": { "type": "array", "items": { "$ref": "#/$defs/projectionRef" } },
    "sourceRevisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "revision"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 },
          "revision": { "type": ["integer", "string", "null"] }
        }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "authoritySource": { "const": "underlying-objects-and-master-control" },
    "executing": { "const": false }
  },
  "$defs": {
    "projectionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "revision": { "type": ["integer", "string", "null"] },
        "sourceId": { "type": ["string", "null"] },
        "detail": { "type": ["string", "null"] }
      }
    }
  }
}
