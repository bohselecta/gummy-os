{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gummy.execution-trace/v1",
  "title": "Gummy Execution Trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "traceId",
    "actorId",
    "agentId",
    "productionId",
    "workOrderId",
    "runtimeBindingId",
    "events"
  ],
  "properties": {
    "traceId": { "type": "string", "minLength": 1 },
    "actorId": { "type": "string", "minLength": 1 },
    "agentId": { "type": "string", "minLength": 1 },
    "productionId": { "type": "string", "minLength": 1 },
    "workOrderId": { "type": "string", "minLength": 1 },
    "runtimeBindingId": { "type": "string", "minLength": 1 },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "kind", "at", "evidenceClass"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 0 },
          "kind": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "format": "date-time" },
          "evidenceClass": {
            "enum": [
              "authority",
              "telemetry",
              "checkpoint",
              "return-candidate",
              "return",
              "receipt",
              "acceptance",
              "publication"
            ]
          },
          "externalId": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
