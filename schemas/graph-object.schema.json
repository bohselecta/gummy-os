{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mygum.my/schemas/graph-object.schema.json",
  "title": "Legacy Gummy Graph Object — Protocol 0.1 Migration Input",
  "description": "Legacy Protocol 0.1 graph object. Read only for deterministic migration into gummy.gummy/v0, gummy.bowl/v0, or gummy.link/v0. Fork lineage migrates to gummy.grab/v0 and a grab-of Link.",
  "type": "object",
  "required": ["schema", "id", "kind", "owner", "visibility"],
  "properties": {
    "schema": { "const": "gummy.graph-object/v0" },
    "id": { "type": "string" },
    "kind": { "enum": ["bowl", "drop", "link", "project", "conversation", "artifact", "application"] },
    "owner": { "type": "string" },
    "visibility": { "enum": ["private", "invite", "organization", "public"] },
    "title": { "type": "string" },
    "content": {},
    "provenance": { "type": "object" },
    "capabilities": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
