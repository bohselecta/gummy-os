{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gummy.mcp-server-descriptor/v1",
  "title": "Gummy MCP Server Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "serverId",
    "displayName",
    "protocolVersions",
    "transport",
    "capabilities",
    "authorization",
    "trust"
  ],
  "properties": {
    "serverId": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "protocolVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "transport": { "enum": ["stdio", "streamable-http"] },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "issuerValidated"],
      "properties": {
        "mode": { "enum": ["none", "oauth", "oidc", "workload-identity"] },
        "issuerValidated": { "type": "boolean" }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "taskIdsScoped", "liveVerified"],
      "properties": {
        "profile": { "enum": ["deterministic", "local", "remote"] },
        "taskIdsScoped": { "type": "boolean" },
        "liveVerified": { "type": "boolean" }
      }
    }
  }
}
