{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mygum.my/schemas/place-local-record.schema.json",
  "title": "Gummy Local Place Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema",
    "placeId",
    "ownerActorId",
    "contextType",
    "contextId",
    "recordType",
    "recordId",
    "revision",
    "value",
    "createdAt",
    "updatedAt",
    "deletedAt"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^place-local:" },
    "schema": { "const": "gummy.place-local-record/v1" },
    "placeId": { "type": "string", "pattern": "^app:" },
    "ownerActorId": { "type": "string", "pattern": "^actor:" },
    "contextType": { "enum": ["personal", "production", "session"] },
    "contextId": { "type": "string", "minLength": 1 },
    "recordType": { "type": "string", "minLength": 1 },
    "recordId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "value": { "type": "object" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "deletedAt": { "type": ["string", "null"], "format": "date-time" }
  }
}
