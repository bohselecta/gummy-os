{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mygum.my/schemas/production-actor-configuration.schema.json",
  "title": "Gummy OS Production Actor Configuration",
  "type": "object",
  "required": ["schema", "id", "productionId", "actorId", "surfaceId", "capabilityId", "settings", "inputGummyIds", "outputContract", "readiness", "revision", "hash", "updatedBy", "updatedAt"],
  "properties": {
    "schema": { "const": "gummy.production-actor-configuration/v0" },
    "id": { "type": "string", "pattern": "^production-config:" },
    "productionId": { "type": "string", "pattern": "^production:" },
    "actorId": { "type": "string", "pattern": "^actor:" },
    "surfaceId": { "type": "string" },
    "capabilityId": { "type": "string", "pattern": "^capability:" },
    "capabilityVersion": { "type": "string" },
    "role": { "type": "string" },
    "moldId": { "type": "string", "pattern": "^mold:" },
    "relationshipLinkIds": { "type": "array", "items": { "type": "string", "pattern": "^link:" }, "uniqueItems": true },
    "inputGummyIds": { "type": "array", "items": { "type": "string", "pattern": "^gummy:" }, "uniqueItems": true },
    "settingsSchemaRef": { "type": "string" },
    "settings": { "type": "object" },
    "upstreamActorIds": { "type": "array", "items": { "type": "string", "pattern": "^actor:" }, "uniqueItems": true },
    "downstreamActorIds": { "type": "array", "items": { "type": "string", "pattern": "^actor:" }, "uniqueItems": true },
    "outputContract": { "type": "object" },
    "localityPolicy": { "type": "object" },
    "privacyPolicy": { "type": "object" },
    "retentionPolicy": { "type": "object" },
    "contributionPolicy": { "type": "object" },
    "costCeiling": { "type": "object" },
    "validation": { "type": "object" },
    "readiness": { "enum": ["not-started", "needs-input", "needs-permission", "needs-configuration", "invalid", "ready", "locked-for-run"] },
    "revision": { "type": "string" },
    "hash": { "type": "string" },
    "updatedBy": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
