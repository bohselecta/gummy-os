{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mygum.my/schemas/snack.schema.json",
  "title": "Legacy Gummy Snack — Protocol 0.1 Migration Input",
  "description": "Legacy Protocol 0.1 object that conflates acting identity and representation. Read only for migration into one gummy.actor/v0 plus at least one gummy.mold/v0. Do not emit new Snack objects after Protocol 0.2 migration acceptance.",
  "type": "object",
  "required": ["schema", "id", "name", "handle", "shape", "colors"],
  "properties": {
    "schema": { "const": "gummy.snack/v0" },
    "id": { "type": "string", "pattern": "^snack:" },
    "name": { "type": "string", "minLength": 1 },
    "handle": { "type": "string", "pattern": "^@" },
    "flavor": { "type": "string" },
    "shape": { "enum": ["squircle", "orb", "bean", "diamond"] },
    "colors": {
      "type": "object",
      "required": ["primary", "secondary", "accent"],
      "properties": {
        "primary": { "type": "string" },
        "secondary": { "type": "string" },
        "accent": { "type": "string" }
      },
      "additionalProperties": false
    },
    "companion": { "type": "string" },
    "visibility": { "enum": ["private", "invite", "public"] },
    "identityProof": { "type": "object" }
  },
  "additionalProperties": true
}
